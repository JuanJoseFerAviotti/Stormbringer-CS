    {
      "id": "constitution",
      "name": "Constitution",
      "requiredStat": "constitution",
      "minimumStat": 13,
      "talents": [

        {
          "id":"second_wind",
          "name":"Second Wind",
          "requires":[],
          "maxRank":1,"description":"On your turn, you can use an action to regain hit points equal to 1d10 + your constitution modifier level. You restore stamina equal to 1/3 of the healing done by this ability Once you use this feature, you must finish a short or long rest before you can use it again."
        },
        {
          "id":"indomitable",
          "name":"Indomitable",
          "requires":["second_wind"],
          "maxRank":3,"icon": 6,"description":"placeholder description"
        },
        {
          "id":"survivor",
          "name":"Survivor",
          "requires":["indomitable"],
          "maxRank":1,"description":"placeholder description"
        },

        {
          "id":"rage",
          "name":"Rage",
          "requires":[],
          "maxRank":1,"icon": 5,"description":"In battle, you fight with primal ferocity. On your turn, you can enter a rage as a action. While raging, you gain the following benefits: When you make a melee weapon attack using Strength, you gain a bonus to the damage roll equal Strenght modifier, half if in heavy armor. if you aren't wearing heavy armor: You have resistance to bludgeoning, piercing, and slashing damage. You have advantage on Strength checks and Strength saving throws. If you are able to cast spells, you can't cast them or concentrate on them while raging. Your rage lasts for 1 minute. It ends early if you are knocked unconscious or if your turn ends and you haven't attacked a hostile creature since your last turn or taken damage since then. You can also end your rage on your turn as a free action."
        },
        {
          "id":"unarmored_defense",
          "name":"Unarmored Defense",
          "requires":["rage"],
          "maxRank":1,"icon": 4,"description":"While you are not wearing any armor, your armor class equals 10 + your Dexterity modifier + your Constitution modifier. You can use a shield and still gain this benefit."
        },
        {
          "id":"relentless_rage",
          "name":"Relentless Rage",
          "requires":["unarmored_defense"],
          "maxRank":1,"icon": 23,"description":"your rage can keep you fighting despite grievous wounds. If you drop to 0 hit points while you're raging and don't die outright, you can make a DC 10 Constitution saving throw. If you succeed, you drop to 1 hit point instead. Each time you use this feature after the first, the DC increases by 5. When you finish a short or long rest, the DC resets to 10."
        },
        {
          "id":"persistent_rage",
          "name":"Persistent Rage",
          "requires":["relentless_rage"],
          "maxRank":1,"description":"your rage is so fierce that it ends early only if you fall unconscious or if you choose to end it."
        },
        {
          "id":"primal_champion",
          "name":"Primal Champion",
          "requires":["persistent_rage"],
          "maxRank":1,"description":"you embody the power of the wilds. Your Strength and Constitution scores increase by 4. Your maximum for those scores is now 24.(Half if lvl<10)."
        },

